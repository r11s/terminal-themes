# ~/.bashrc — interaktive Shell (kompatibel mit macOS-bash 3.2)
case $- in *i*) ;; *) return ;; esac

# ---------- vi-Modus auf der Kommandozeile ----------
set -o vi
export EDITOR=vim VISUAL=vim

# ---------- History ----------
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T  '
HISTIGNORE='ls:ll:la:l:cd:pwd:exit:clear'
shopt -s histappend cmdhist checkwinsize cdspell dirspell 2>/dev/null

# ---------- Farben ----------
export CLICOLOR=1
export LSCOLORS=exgxfxdxbxegedabagacad   # Verz. blau, Symlink cyan, Programme rot
export LESS='-FRXi'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'

# GNU ls: Farben auch nach Dateiendung
# macOS: brew install coreutils; Windows (Git Bash): schon eingebaut
if [ -d /opt/homebrew/opt/coreutils/libexec/gnubin ]; then
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi
if ls --version >/dev/null 2>&1 && command -v dircolors >/dev/null 2>&1; then
  if [ -r "$HOME/.dircolors" ]; then eval "$(dircolors -b "$HOME/.dircolors")"; else eval "$(dircolors -b)"; fi
  alias ls='ls --color=auto'
  # Windows: Systemdateien mit sehr langen Namen im Home-Ordner (NTUSER.DAT{…}…) ausblenden,
  # sonst schrumpft die Ausgabe auf eine Spalte. Mit ls -a sind sie weiter sichtbar.
  case "$OSTYPE" in
    msys*|cygwin*) alias ls='ls --color=auto --hide="NTUSER.DAT*" --hide="ntuser.*"' ;;
  esac
fi

# ---------- Aliase ----------
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate -20'

# ---------- Prompt: [user@host:]pfad (git-branch) $  — $ rot bei Fehler ----------
# Kurz gehalten: nur die letzten zwei Ordner des Pfads; user@host nur bei SSH.
# Mehr oder weniger Ordner: Zahl bei PROMPT_DEPTH ändern (z. B. 3).
PROMPT_DEPTH=${PROMPT_DEPTH:-2}
__git_branch() {
  local b
  b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return
  printf ' (%s)' "$b"
}
__short_path() {
  local p="$PWD" lead="/" IFS=/ parts n i out
  if [ "$p" = "$HOME" ]; then printf '~'; return; fi
  case "$p" in
    "$HOME"/*) p="${p#"$HOME"/}"; lead="~/" ;;
    *)         p="${p#/}" ;;
  esac
  [ -z "$p" ] && { printf '/'; return; }
  set -f; parts=($p); set +f
  n=${#parts[@]}
  if [ "$n" -le "$PROMPT_DEPTH" ]; then printf '%s%s' "$lead" "$p"; return; fi
  out=""
  for ((i = n - PROMPT_DEPTH; i < n; i++)); do out="$out${out:+/}${parts[i]}"; done
  printf '…/%s' "$out"
}
__prompt() {
  local rc=$?
  history -a
  __P_C=32; [ $rc -ne 0 ] && __P_C=31
  __P_PATH=$(__short_path)
  __P_GIT=$(__git_branch)
  __P_WHO=""; [ -n "$SSH_CONNECTION" ] && __P_WHO="${USER}@${HOSTNAME%%.*}:"
}
# Pfad und Branch stehen in Variablen und werden vom Prompt nur eingesetzt,
# nicht erneut ausgewertet (Ordnernamen mit $ oder ` bleiben harmlos).
PS1='\[\e[1;36m\]${__P_WHO}\[\e[0m\]\[\e[1;34m\]${__P_PATH}\[\e[0;33m\]${__P_GIT}\[\e[0m\] \[\e[1;${__P_C}m\]\$\[\e[0m\] '
PROMPT_COMMAND=__prompt
