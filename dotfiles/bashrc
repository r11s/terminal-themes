# ~/.bashrc — interaktive Shell (kompatibel mit macOS-bash 3.2)
case $- in *i*) ;; *) return ;; esac

# ---------- vi-Modus auf der Kommandozeile ----------
set -o vi
export EDITOR=vim VISUAL=vim

# ---------- History ----------
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T  '
HISTIGNORE='ls:ll:la:l:cd:pwd:exit:clear'
shopt -s histappend cmdhist checkwinsize cdspell dirspell 2>/dev/null

# ---------- Farben ----------
export CLICOLOR=1
export LSCOLORS=exgxfxdxbxegedabagacad   # Verz. blau, Symlink cyan, Programme rot
export LESS='-FRXi'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'

# GNU ls (brew install coreutils): Farben auch nach Dateiendung
if [ -d /opt/homebrew/opt/coreutils/libexec/gnubin ]; then
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
  if [ -r "$HOME/.dircolors" ]; then eval "$(dircolors -b "$HOME/.dircolors")"; else eval "$(dircolors -b)"; fi
  alias ls='ls --color=auto'
fi

# ---------- Aliase ----------
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate -20'

# ---------- Prompt: user@host:pfad (git-branch) $  — $ rot bei Fehler ----------
__git_branch() {
  local b
  b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return
  printf ' (%s)' "$b"
}
__prompt() {
  local rc=$? c=32
  history -a
  [ $rc -ne 0 ] && c=31
  PS1="\[\e[1;36m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0;33m\]$(__git_branch)\[\e[0m\] \[\e[1;${c}m\]\\$\[\e[0m\] "
}
PROMPT_COMMAND=__prompt
