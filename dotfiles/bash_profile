# ~/.bash_profile — Login-Shell (Terminal.app startet immer eine Login-Shell)
export BASH_SILENCE_DEPRECATION_WARNING=1

# Homebrew (macOS, nur wenn vorhanden) zuerst, danach eigene Verzeichnisse davor
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv bash)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv bash)"
fi
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# rbenv
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - --no-rehash bash)"

# Interaktive Einstellungen
[ -f ~/.bashrc ] && . ~/.bashrc
